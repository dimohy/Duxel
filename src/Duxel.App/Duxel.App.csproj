<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Duxel.App</PackageId>
    <Version>0.3.0-preview</Version>
    <Authors>dimohy</Authors>
    <Description>Shared Duxel UI runtime, Fluent 2 widgets and themes, Vulkan renderer, and declarative UI source generator.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dimohy/Duxel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dimohy/Duxel</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget-package-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="../Duxel.Core/Assets/FluentIcons/LICENSE" Pack="true" PackagePath="licenses/FluentSystemIcons/" />
    <None Include="../Duxel.Core/Duxel.Core.ThirdPartyNotices.txt" Pack="true" PackagePath="Duxel.Core.ThirdPartyNotices.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(DuxelValidationHooks)' == 'true'">
    <InternalsVisibleTo Include="Duxel.Rendering.Tests" />
    <InternalsVisibleTo Include="Duxel.Graphics.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Duxel.Core\Duxel.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Duxel.Vulkan\Duxel.Vulkan.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Duxel.Core.Dsl.Generator\Duxel.Core.Dsl.Generator.csproj"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <!-- Duxel.Core is bundled, so its Markdown dependency must flow to package consumers. -->
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <Target Name="IncludeProjectReferenceOutputsInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeDslGeneratorAnalyzerInPackage" DependsOnTargets="ResolveReferences"
          Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <_DslGeneratorAnalyzer Include="@(Analyzer)"
                            Condition="'%(Analyzer.Filename)' == 'Duxel.Core.Dsl.Generator'" />
      <TfmSpecificPackageFile Include="@(_DslGeneratorAnalyzer)"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
    <Error Condition="'@(_DslGeneratorAnalyzer)' == ''" Text="The Duxel DSL generator must be resolved before packing." />
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProjectReferenceOutputsInPackage</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeDslGeneratorAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

</Project>

