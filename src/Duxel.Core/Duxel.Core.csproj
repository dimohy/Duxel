<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PackageId>Duxel.Core</PackageId>
    <Version>0.2.0-preview</Version>
    <Authors>dimohy</Authors>
    <Description>Core types and immediate-mode UI runtime for Duxel.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dimohy/Duxel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dimohy/Duxel</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <Content Include="Duxel.Core.ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(DuxelValidationHooks)' == 'true'">
    <Compile Include="../../tests/Duxel.Rendering.Tests/InputLegacyReference.cs" Link="Validation/InputLegacyReference.cs" />
    <Compile Include="../../tests/Duxel.Rendering.Tests/ParagraphRasterValidation.cs" Link="Validation/ParagraphRasterValidation.cs" />
    <InternalsVisibleTo Include="Duxel.Rendering.Tests" />
    <InternalsVisibleTo Include="Duxel.Control.Tests" />
    <InternalsVisibleTo Include="Duxel.Graphics.Tests" />
    <InternalsVisibleTo Include="Duxel.Vulkan.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Duxel.App" />
    <InternalsVisibleTo Include="Duxel.Svg" />
    <InternalsVisibleTo Include="Duxel.Vulkan" />
    <InternalsVisibleTo Include="Duxel.Platform.Windows" />
    <InternalsVisibleTo Include="Duxel.Platform.Linux" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
    <ProjectReference Include="../Duxel.Core.Dsl.Generator/Duxel.Core.Dsl.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="FluentComponents.tsv" />
    <AdditionalFiles Include="Assets/FluentIcons/FluentSystemIcons-Regular.json" />
    <AdditionalFiles Include="Assets/FluentIcons/FluentSystemIcons-Filled.json" />
    <EmbeddedResource Include="Assets/FluentIcons/*.ttf"
                      LogicalName="Duxel.Core.FluentIcons.%(Filename)%(Extension)" />
    <Content Include="Assets/FluentIcons/FluentSystemIcons-Regular.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/FluentIcons/FluentSystemIcons-Filled.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/FluentIcons/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <CompilerVisibleProperty Include="DuxelRequireCompleteFluentCatalog" />
  </ItemGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);DUX_NATIVEAOT</DefineConstants>
  </PropertyGroup>

</Project>

