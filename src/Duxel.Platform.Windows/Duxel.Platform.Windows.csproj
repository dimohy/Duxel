<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <PackageId>Duxel.Platform.Windows</PackageId>
    <Version>$(DuxelVersion)</Version>
    <Authors>dimohy</Authors>
    <Description>Windows platform services for Duxel (clipboard/IME).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dimohy/Duxel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dimohy/Duxel</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Duxel.Core\Duxel.Core.csproj" />
    <Compile Include="../Shared/DirectWriteTextShaper.cs" Link="Interop/DirectWriteTextShaper.cs" />
    <Compile Include="../Shared/DirectWriteHangulInput.cs" Link="Interop/DirectWriteHangulInput.cs" />
    <Compile Include="../Shared/DirectWriteLongTextShaper.cs" Link="Interop/DirectWriteLongTextShaper.cs" />
    <Compile Include="../Shared/DirectWriteLongTextShaper.Callbacks.cs" Link="Interop/DirectWriteLongTextShaper.Callbacks.cs" />
    <Compile Include="../Shared/DirectWriteLongTextShaper.FontScope.cs" Link="Interop/DirectWriteLongTextShaper.FontScope.cs" />
    <Compile Include="../Shared/DirectWriteLongTextShaper.Paragraph.cs" Link="Interop/DirectWriteLongTextShaper.Paragraph.cs" />
    <Compile Include="../Shared/DirectWriteLongTextShaper.InlineObjects.cs" Link="Interop/DirectWriteLongTextShaper.InlineObjects.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(DuxelValidationHooks)' == 'true'">
    <InternalsVisibleTo Include="Duxel.Rendering.Tests" />
    <InternalsVisibleTo Include="Duxel.Graphics.Tests" />
    <Compile Include="../../tests/Duxel.Rendering.Tests/WindowsValidationHooks.cs" Link="WindowsValidationHooks.cs" />
  </ItemGroup>

</Project>

