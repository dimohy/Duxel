float rectangleCoverage(vec4 rectangle, vec2 point) {
    vec2 covered = min(point + .5, rectangle.zw) - max(point - .5, rectangle.xy);
    float coverage = clamp(min(covered.x, covered.y), 0.0, 1.0);
    vec2 outside = max(rectangle.xy - point, point - rectangle.zw);
    return all(greaterThan(outside, vec2(0.0))) ? min(coverage, max(0.0, .5 - length(outside))) : coverage;
}
bool triangleCoordinates(vec2 p, vec2 a, vec2 b, vec2 c, out vec3 weights) {
    float determinant = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
    if (determinant == 0.0) return false;
    weights.x = ((b.y - c.y) * (p.x - c.x) + (c.x - b.x) * (p.y - c.y)) / determinant;
    weights.y = ((c.y - a.y) * (p.x - c.x) + (a.x - c.x) * (p.y - c.y)) / determinant;
    weights.z = 1.0 - weights.x - weights.y;
    return all(greaterThanEqual(weights, vec3(0.0)));
}
// Same local frame, one-pixel fringe and analytic material coordinates as the
// retained analytic primitive. Device vertices are generated by the GPU camera.
float analyticCoverage(uint offset, vec2 devicePoint, vec2 scale, vec2 origin, out vec2 materialPoint) {
    vec4 rect = pc.scene.data[offset];
    vec4 rxFrame = pc.scene.data[offset + 1u];
    vec4 rest = pc.scene.data[offset + 2u];
    vec2 radii = rxFrame.xy;
    mat2 frame = mat2(rxFrame.zw, rest.xy);
    vec2 translation = rest.zw;
    mat2 mapping = mat2(frame[0] * scale, frame[1] * scale);
    vec2 mappedOrigin = translation * scale + origin;
    mat2 inv = inverse(mapping);
    vec2 gradientX = vec2(inv[0].x, inv[1].x);
    vec2 gradientY = vec2(inv[0].y, inv[1].y);
    vec2 plane = 1.0 / vec2(length(gradientX), length(gradientY));
    float coverageScale = min(1.0, min(rect.z * plane.x, rect.w * plane.y));
    float bias = 1.0 - .5 * coverageScale;
    vec2 first = rect.xy, last = rect.xy + rect.zw;
    vec2 delta = (1.0 - .4142135623730951) * radii;
    vec2 local[8] = vec2[8](vec2(first.x, first.y + delta.y), vec2(first.x + delta.x, first.y),
        vec2(last.x - delta.x, first.y), vec2(last.x, first.y + delta.y),
        vec2(last.x, last.y - delta.y), vec2(last.x - delta.x, last.y),
        vec2(first.x + delta.x, last.y), vec2(first.x, last.y - delta.y));
    vec2 positions[8], normals[8];
    for (uint i = 0u; i < 8u; ++i) positions[i] = mapping * local[i] + mappedOrigin;
    float winding = determinant(mapping) > 0.0 ? 1.0 : -1.0;
    for (uint i = 0u; i < 8u; ++i) {
        vec2 edge = positions[(i + 1u) & 7u] - positions[i];
        normals[i] = length(edge) == 0.0 ? vec2(0.0) : normalize(vec2(edge.y, -edge.x)) * winding;
    }
    vec2 center = (first + last) * .5;
    vec2 centerPosition = mapping * center + mappedOrigin;
    materialPoint = vec2(0.0);
    for (uint i = 0u; i < 8u; ++i) {
        uint next = (i + 1u) & 7u;
        vec2 p[6] = vec2[6](positions[i], positions[next], positions[i] + normals[i],
            positions[next] + normals[i], positions[i] + normals[(i + 7u) & 7u], centerPosition);
        vec2 l[6] = vec2[6](local[i], local[next], local[i], local[next], local[i], center);
        const float o[6] = float[6](0.0, 0.0, 1.0, 1.0, 1.0, 0.0);
        for (uint j = 0u; j < 6u; ++j) p[j] = roundEven(p[j] * 256.0) / 256.0;
        bool diagonal = local[i].x != local[next].x && local[i].y != local[next].y;
        uvec3 triangles[4];
        triangles[0] = diagonal ? uvec3(0u, 2u, 1u) : uvec3(0u, 1u, 3u);
        triangles[1] = diagonal ? uvec3(2u, 1u, 3u) : uvec3(0u, 3u, 2u);
        triangles[2] = uvec3(0u, 4u, 2u);
        triangles[3] = uvec3(5u, 0u, 1u);
        for (uint j = 0u; j < 4u; ++j) {
            uvec3 t = triangles[j];
            vec3 weights;
            if (!triangleCoordinates(devicePoint, p[t.x], p[t.y], p[t.z], weights)) continue;
            vec2 point = l[t.x] * weights.x + l[t.y] * weights.y + l[t.z] * weights.z;
            float outset = o[t.x] * weights.x + o[t.y] * weights.y + o[t.z] * weights.z;
            float distance = min(min(point.x - first.x, last.x - point.x) * plane.x,
                min(point.y - first.y, last.y - point.y) * plane.y);
            vec2 uv = vec2(point.x < first.x + radii.x ? point.x - first.x - radii.x : point.x > last.x - radii.x ? point.x - last.x + radii.x : 0.0,
                point.y < first.y + radii.y ? point.y - first.y - radii.y : point.y > last.y - radii.y ? point.y - last.y + radii.y : 0.0);
            if (uv.x != 0.0 && uv.y != 0.0) {
                vec2 normalized = uv / (radii * radii);
                vec2 gradient = normalized.x * gradientX + normalized.y * gradientY;
                distance = min(distance, .5 * (1.0 - dot(uv, normalized)) / length(gradient));
            }
            materialPoint = frame * point + translation;
            return clamp(coverageScale * (distance - outset + bias), 0.0, 1.0);
        }
    }
    return 0.0;
}
