<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(DuxelBenchmarkFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(DuxelBenchmarkFramework)' != ''">$(DuxelBenchmarkFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DuxelCoreProject Condition="'$(DuxelCoreProject)' == ''">../../src/Duxel.Core/Duxel.Core.csproj</DuxelCoreProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(DuxelCoreProject)" />
    <ProjectReference Include="../../src/Duxel.Platform.Windows/Duxel.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
