<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(DuxelBenchmarkFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(DuxelBenchmarkFramework)' != ''">$(DuxelBenchmarkFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Duxel.Linux.App/Duxel.Linux.App.csproj" />
    <ProjectReference Include="../../src/Duxel.Platform.Linux/Duxel.Platform.Linux.csproj" />
    <ProjectReference Include="../../src/Duxel.Vulkan/Duxel.Vulkan.csproj" />
    <ProjectReference Include="../../src/Duxel.Svg/Duxel.Svg.csproj" />
    <None Include="../../samples/Duxel.Linux.Sample/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../samples/Duxel.Linux.Sample/LinuxDemoScreen.cs" Link="LinuxDemoScreen.cs" />
    <Compile Include="../Duxel.Platform.Linux.Tests/NativePeer.cs" Link="NativePeer.cs" />
    <Compile Include="../Duxel.Graphics.Tests/NativeAnnouncementScene.cs" Link="NativeAnnouncementScene.cs" />
    <Compile Include="../Shared/DialogAccessibilityScreen.cs" Link="DialogAccessibilityScreen.cs" />
    <Compile Include="../Shared/AppStartupRetryTests.cs" Link="AppStartupRetryTests.cs" />
    <Compile Include="../Shared/NativeMessageBarScene.cs" Link="NativeMessageBarScene.cs" />
  </ItemGroup>
</Project>
